---
// Raíz: redirige al idioma del navegador (por defecto español).
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Alvaro Mercado</title>
    <meta http-equiv="refresh" content="0; url=/es/" />
    <link rel="canonical" href="/es/" />
    <script is:inline>
      var l = (navigator.language || 'es').toLowerCase().indexOf('en') === 0 ? 'en' : 'es';
      location.replace('/' + l + '/');
    </script>
  </head>
  <body></body>
</html>
