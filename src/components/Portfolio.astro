---
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import GraphBackground from './GraphBackground.astro';
import Job from './Job.astro';
import cutout from '../assets/alvaro-cutout.png';
import { content, site, type Lang } from '../i18n/content';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = content[lang];
const other: Lang = lang === 'es' ? 'en' : 'es';
const marquee = [...t.marquee, ...t.marquee];
const RECENT = 4;
const recent = t.experience.items.slice(0, RECENT);
const older = t.experience.items.slice(RECENT);
// La misma silueta se usa como máscara de la capa de iluminación
const litMask = await getImage({ src: cutout, format: 'webp', width: 640 });
const skip = lang === 'es' ? 'Saltar al contenido' : 'Skip to content';
const links = [
  ['about', t.nav.about],
  ['experience', t.nav.experience],
  ['projects', t.nav.projects],
  ['skills', t.nav.skills],
  ['contact', t.nav.contact],
];
---
<Base t={t}>
  <a class="skip" href="#top">{skip}</a>
  <header class="header on-hero">
    <div class="wrap">
      <a href="#top" class="logo"><i></i>{site.name}</a>
      <nav class="nav" aria-label="Main">
        {links.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
      </nav>
      <div class="tools">
        <details class="menu">
          <summary class="pill" aria-label="Menu">☰</summary>
          <nav class="menu-panel" aria-label="Mobile">
            {links.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
          </nav>
        </details>
        <button class="pill icon" type="button" data-theme-toggle aria-label="Toggle theme">
          <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" fill="currentColor"/></svg>
          <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5.3 5.3l1.7 1.7M17 17l1.7 1.7M5.3 18.7 7 17M17 7l1.7-1.7"/></g></svg>
        </button>
        <a class="pill" href={`/${other}/`} hreflang={other} lang={other} title={t.switch.label}>{t.switch.short}</a>
      </div>
    </div>
  </header>

  <main id="top">
    <!-- Hero -->
    <section class="hero">
      <GraphBackground />
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <span class="label eyebrow">{t.hero.eyebrow}</span>
          <h1>{t.hero.title[0]} <em>{t.hero.title[1]}</em></h1>
          <p class="lead">{t.hero.lead}</p>
          <div class="actions">
            <a class="btn" href="#contact">{t.hero.cta} →</a>
            <a class="btn ghost" href={t.hero.cvFile} download>{t.hero.cv} ↓</a>
          </div>
          <div class="socials">
            <a href={site.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
            </a>
            <a href={site.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
              <svg viewBox="0 0 24 24"><path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.49 1 .11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 12 .3"/></svg>
            </a>
            <a href={`mailto:${site.email}`} aria-label="Email">
              <svg viewBox="0 0 24 24"><path d="M2 5.5A2.5 2.5 0 0 1 4.5 3h15A2.5 2.5 0 0 1 22 5.5v13a2.5 2.5 0 0 1-2.5 2.5h-15A2.5 2.5 0 0 1 2 18.5v-13zm2.3.2 7.7 6.1 7.7-6.1a.5.5 0 0 0-.2-.05H4.5a.5.5 0 0 0-.2.05zM20 7.6l-7.4 5.85a1 1 0 0 1-1.2 0L4 7.6v10.9a.5.5 0 0 0 .5.5h15a.5.5 0 0 0 .5-.5V7.6z"/></svg>
            </a>
            <span class="loc">{t.hero.location}</span>
          </div>
        </div>
        <div class="portrait">
          <div class="frame" style={`--cutout:url(${litMask.src})`}>
            <div class="lit">
              <Picture
                src={cutout}
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                widths={[280, 420, 560, 800]}
                sizes="(max-width: 700px) 260px, 460px"
                alt={t.hero.photoAlt}
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </div>
          </div>
          <div class="badge"><span>{t.hero.badge.label}</span><b>{t.hero.badge.value}</b></div>
        </div>
      </div>
    </section>

    <!-- Marquee -->
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        {marquee.map((m) => <span>{m}</span>)}
      </div>
    </div>

    <!-- Stats -->
    <section class="stats">
      <div class="wrap stats-grid">
        {t.stats.map((s) => (
          <div class="stat reveal">
            <div class="v">{s.value}</div>
            <div class="l">{s.label}</div>
            <div class="s">{s.sub}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- About -->
    <section id="about" class="about">
      <div class="wrap about-grid">
        <div class="reveal">
          <span class="label">{t.about.label}</span>
          <h2 class="h2">{t.about.title}</h2>
        </div>
        <div class="reveal">
          {t.about.paragraphs.map((p) => <p>{p}</p>)}
          <div class="langs">
            {t.about.langList.map(([n, l]) => (
              <div><b>{n}</b><span>{l}</span></div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section id="experience">
      <div class="wrap">
        <div class="reveal">
          <span class="label">{t.experience.label}</span>
          <h2 class="h2">{t.experience.title}</h2>
        </div>
        <div class="timeline">
          {recent.map((j) => <Job job={j} currentLabel={t.experience.current} />)}
          {older.length > 0 && (
            <details class="older">
              <summary>
                <span>{t.experience.older} <em>· {t.experience.olderRange}</em></span>
                <i aria-hidden="true"></i>
              </summary>
              {older.map((j) => <Job job={j} currentLabel={t.experience.current} reveal={false} />)}
            </details>
          )}
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section id="projects" style="padding-top:0">
      <div class="wrap">
        <div class="reveal">
          <span class="label">{t.projects.label}</span>
          <h2 class="h2">{t.projects.title}</h2>
          <p class="section-lead">{t.projects.text}</p>
        </div>
        <div class="projects-grid">
          {t.projects.items.map((p) => (
            <a class="project reveal" href={`${site.github}/${p.name}`} target="_blank" rel="noopener noreferrer">
              <div class="p-top">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v16H6.5a1 1 0 0 0 0 2H20v2H6.5A2.5 2.5 0 0 1 4 19.5v-15zM6.5 4a.5.5 0 0 0-.5.5v11.2c.15-.07.32-.1.5-.1H18V4H6.5z" fill="currentColor"/></svg>
                <span class="p-view">{t.projects.view} ↗</span>
              </div>
              <h3>{p.name}</h3>
              <p>{p.desc}</p>
              <div class="chips">{p.tags.map((tag) => <span class="chip">{tag}</span>)}</div>
            </a>
          ))}
        </div>
        <a class="more" href={site.github} target="_blank" rel="noopener noreferrer">{t.projects.more} →</a>
      </div>
    </section>

    <!-- Pillars -->
    <section style="padding-top:0">
      <div class="wrap">
        <div class="reveal">
          <span class="label">{t.pillars.label}</span>
          <h2 class="h2">{t.pillars.title}</h2>
        </div>
        <div class="pillars-grid">
          {t.pillars.items.map((p) => (
            <div class="pillar reveal">
              <span class="n">{p.n}</span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Skills + education -->
    <section id="skills">
      <div class="wrap">
        <div class="reveal">
          <span class="label">{t.skills.label}</span>
          <h2 class="h2">{t.skills.title}</h2>
        </div>
        <div class="skills-grid">
          {t.skills.groups.map(([name, list]) => (
            <div class="skill-group reveal">
              <h3>{name}</h3>
              <div class="chips">{list.map((s) => <span class="chip lg">{s}</span>)}</div>
            </div>
          ))}
        </div>
        <div class="edu-wrap reveal">
          <span class="label">{t.education.label}</span>
          <div class="edu">
            {t.education.items.map((e) => (
              <div class="edu-item">
                <time>{e.period}</time>
                <b>{e.title}</b>
                <span>{e.place}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" style="padding-top:0">
      <div class="contact reveal">
        <span class="label">{t.contact.label}</span>
        <h2>{t.contact.title[0]}<br />{t.contact.title[1]}</h2>
        <p>{t.contact.text}</p>
        <div class="actions">
          <a class="btn" href={`mailto:${site.email}`}>{t.contact.cta} →</a>
          <button class="btn ghost" type="button" data-copy={site.email} data-done={t.contact.copied}>{t.contact.copy}</button>
          <a class="btn ghost" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
          <a class="btn ghost" href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </div>
        <span class="mail">{site.email}</span>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap">
      <span>© {new Date().getFullYear()} {site.name}. {t.footer.rights}</span>
      <span class="flinks">
        <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="#top">{t.footer.top}</a>
      </span>
    </div>
  </footer>
</Base>
